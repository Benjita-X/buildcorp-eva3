# Copiar a .env y completar. NUNCA subir el .env real a GitHub.

DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=False
# IP pública / DNS de la instancia EC2 (separados por coma)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,IP_PUBLICA_EC2
DJANGO_CSRF_TRUSTED_ORIGINS=http://IP_PUBLICA_EC2

# PostgreSQL (en la misma instancia EC2)
DB_ENGINE=postgres
DB_NAME=buildcorp
DB_USER=buildcorp
DB_PASSWORD=cambiar-clave-postgres
DB_HOST=localhost
DB_PORT=5432

# Sesión: segundos de inactividad antes de expirar (1800 = 30 min)
SESSION_COOKIE_AGE=1800
USE_HTTPS=False

# Clave de los usuarios demo creados con: manage.py cargar_datos_iniciales --demo
DEMO_PASSWORD=cambiar-clave-demo
