# ETAPA 5 de la receta: Gunicorn como servicio de systemd.
# Se copia a /etc/systemd/system/buildcorp.service. systemd lo mantiene siempre encendido.
# ExecStart: Gunicorn con 3 workers, escuchando en un socket unix (Nginx se conecta ahí).
[Unit]
Description=Gunicorn para BuildCorp
After=network.target

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/apps/buildcorp
ExecStart=/home/ubuntu/apps/buildcorp/venv/bin/gunicorn --workers 3 --bind unix:/home/ubuntu/apps/buildcorp.sock config.wsgi:application

[Install]
WantedBy=multi-user.target
