[Unit]
Description=Gunicorn para BuildCorp
After=network.target

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/apps/buildcorp
ExecStart=/home/ubuntu/apps/buildcorp/venv/bin/gunicorn --workers 3 --bind unix:/home/ubuntu/apps/buildcorp.sock config.wsgi:application

[Install]
WantedBy=multi-user.target
